{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "${website}",
    "sources": "${source_url}",
    "issues": "${issue_tracker}"
  },
  "license": "${license}",
  "icon": "${icon}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.bsmp.bouncestyles.fabric.BounceStylesFabric"
    ],
    "client": [
      "dev.bsmp.bouncestyles.fabric.BounceStylesFabricClient"
    ]
  },
  "mixins": [
    "mixins.bounce_styles.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": "${loader_version}",
    "java": ">=21",
    "fabric-api": "*",
    "architectury": "${architectury_version}",
    "geckolib": "${geckolib_version}"
  }
}